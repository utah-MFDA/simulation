VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN fan_out_net ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 2550000 1600000 ) ;
ROW ROW_0 CoreSite 60000 240000 N DO 81 BY 1 STEP 30000 0 ;
ROW ROW_1 CoreSite 60000 480000 FS DO 81 BY 1 STEP 30000 0 ;
ROW ROW_2 CoreSite 60000 720000 N DO 81 BY 1 STEP 30000 0 ;
ROW ROW_3 CoreSite 60000 960000 FS DO 81 BY 1 STEP 30000 0 ;
ROW ROW_4 CoreSite 60000 1200000 N DO 81 BY 1 STEP 30000 0 ;
TRACKS X 30000 DO 84 STEP 30000 LAYER met1 ;
TRACKS Y 30000 DO 53 STEP 30000 LAYER met1 ;
TRACKS X 30000 DO 84 STEP 30000 LAYER met2 ;
TRACKS Y 30000 DO 53 STEP 30000 LAYER met2 ;
TRACKS X 30000 DO 84 STEP 30000 LAYER met3 ;
TRACKS Y 30000 DO 53 STEP 30000 LAYER met3 ;
TRACKS X 30000 DO 84 STEP 30000 LAYER met4 ;
TRACKS Y 30000 DO 53 STEP 30000 LAYER met4 ;
TRACKS X 30000 DO 84 STEP 30000 LAYER met5 ;
TRACKS Y 30000 DO 53 STEP 30000 LAYER met5 ;
TRACKS X 30000 DO 84 STEP 30000 LAYER met6 ;
TRACKS Y 30000 DO 53 STEP 30000 LAYER met6 ;
TRACKS X 30000 DO 84 STEP 30000 LAYER met7 ;
TRACKS Y 30000 DO 53 STEP 30000 LAYER met7 ;
TRACKS X 30000 DO 84 STEP 30000 LAYER met8 ;
TRACKS Y 30000 DO 53 STEP 30000 LAYER met8 ;
TRACKS X 30000 DO 84 STEP 30000 LAYER met9 ;
TRACKS Y 30000 DO 53 STEP 30000 LAYER met9 ;
TRACKS X 30000 DO 84 STEP 30000 LAYER met10 ;
TRACKS Y 30000 DO 53 STEP 30000 LAYER met10 ;
GCELLGRID X 0 DO 5 STEP 450000 ;
GCELLGRID Y 450000 DO 2 STEP 700000 ;
COMPONENTS 3 ;
    - serp1 serpentine_100px_0 + PLACED ( 1080000 720000 ) N ;
    - serp2 serpentine_200px_0 + PLACED ( 990000 960000 ) FS ;
    - serp3 serpentine_200px_0 + PLACED ( 1290000 960000 ) FS ;
END COMPONENTS
PINS 3 ;
    - out1 + NET out1 + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met9 ( -7000 -7000 ) ( 7000 7000 )
        + FIXED ( 1590000 1110000 ) N ;
    - out2 + NET out2 + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met9 ( -7000 -7000 ) ( 7000 7000 )
        + FIXED ( 1590000 1200000 ) N ;
    - soln1 + NET soln1 + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met9 ( -7000 -7000 ) ( 7000 7000 )
        + FIXED ( 960000 930000 ) N ;
END PINS
NETS 4 ;
    - ch1 ( serp3 in_fluid ) ( serp2 in_fluid ) ( serp1 out_fluid ) + USE SIGNAL
      + ROUTED met2 ( 1320000 960000 ) ( * 1230000 )
      NEW met1 ( 1230000 960000 ) ( 1320000 * )
      NEW met2 ( 1230000 750000 ) ( * 960000 )
      NEW met2 ( 1020000 1230000 ) ( * 1260000 )
      NEW met1 ( 1020000 1260000 ) ( 1320000 * )
      NEW met2 ( 1320000 1230000 ) ( * 1260000 )
      NEW met1 ( 1320000 1230000 ) M1M2_PR
      NEW met1 ( 1320000 960000 ) M1M2_PR
      NEW met1 ( 1230000 960000 ) M1M2_PR
      NEW met1 ( 1230000 750000 ) M1M2_PR
      NEW met1 ( 1020000 1230000 ) M1M2_PR
      NEW met1 ( 1020000 1260000 ) M1M2_PR
      NEW met1 ( 1320000 1260000 ) M1M2_PR ;
    - out1 ( PIN out1 ) ( serp2 out_fluid ) + USE SIGNAL
      + ROUTED met2 ( 1260000 1110000 ) ( * 1230000 )
      NEW met3 ( 1260000 1110000 ) ( 1350000 * )
      NEW met9 ( 1350000 1110000 ) ( 1590000 * 0 )
      NEW met1 ( 1260000 1230000 ) M1M2_PR
      NEW met2 ( 1260000 1110000 ) M2M3_PR
      NEW met3 ( 1350000 1110000 ) M3M4_PR
      NEW met4 ( 1350000 1110000 ) M4M5_PR
      NEW met5 ( 1350000 1110000 ) M5M6_PR
      NEW met6 ( 1350000 1110000 ) M6M7_PR
      NEW met7 ( 1350000 1110000 ) M7M8_PR
      NEW met8 ( 1350000 1110000 ) M8M9_PR ;
    - out2 ( PIN out2 ) ( serp3 out_fluid ) + USE SIGNAL
      + ROUTED met2 ( 1560000 1200000 ) ( * 1230000 )
      NEW met9 ( 1560000 1200000 ) ( 1590000 * 0 )
      NEW met1 ( 1560000 1230000 ) M1M2_PR
      NEW met2 ( 1560000 1200000 ) M2M3_PR
      NEW met3 ( 1560000 1200000 ) M3M4_PR
      NEW met4 ( 1560000 1200000 ) M4M5_PR
      NEW met5 ( 1560000 1200000 ) M5M6_PR
      NEW met6 ( 1560000 1200000 ) M6M7_PR
      NEW met7 ( 1560000 1200000 ) M7M8_PR
      NEW met8 ( 1560000 1200000 ) M8M9_PR ;
    - soln1 ( PIN soln1 ) ( serp1 in_fluid ) + USE SIGNAL
      + ROUTED met2 ( 1110000 750000 ) ( * 930000 )
      NEW met9 ( 960000 930000 0 ) ( 1110000 * )
      NEW met1 ( 1110000 750000 ) M1M2_PR
      NEW met2 ( 1110000 930000 ) M2M3_PR
      NEW met3 ( 1110000 930000 ) M3M4_PR
      NEW met4 ( 1110000 930000 ) M4M5_PR
      NEW met5 ( 1110000 930000 ) M5M6_PR
      NEW met6 ( 1110000 930000 ) M6M7_PR
      NEW met7 ( 1110000 930000 ) M7M8_PR
      NEW met8 ( 1110000 930000 ) M8M9_PR ;
END NETS
END DESIGN
