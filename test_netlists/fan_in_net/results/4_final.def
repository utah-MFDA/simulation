VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN fan_in_net ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 2550000 1600000 ) ;
ROW ROW_0 CoreSite 60000 240000 N DO 81 BY 1 STEP 30000 0 ;
ROW ROW_1 CoreSite 60000 480000 FS DO 81 BY 1 STEP 30000 0 ;
ROW ROW_2 CoreSite 60000 720000 N DO 81 BY 1 STEP 30000 0 ;
ROW ROW_3 CoreSite 60000 960000 FS DO 81 BY 1 STEP 30000 0 ;
ROW ROW_4 CoreSite 60000 1200000 N DO 81 BY 1 STEP 30000 0 ;
TRACKS X 30000 DO 84 STEP 30000 LAYER met1 ;
TRACKS Y 30000 DO 53 STEP 30000 LAYER met1 ;
TRACKS X 30000 DO 84 STEP 30000 LAYER met2 ;
TRACKS Y 30000 DO 53 STEP 30000 LAYER met2 ;
TRACKS X 30000 DO 84 STEP 30000 LAYER met3 ;
TRACKS Y 30000 DO 53 STEP 30000 LAYER met3 ;
TRACKS X 30000 DO 84 STEP 30000 LAYER met4 ;
TRACKS Y 30000 DO 53 STEP 30000 LAYER met4 ;
TRACKS X 30000 DO 84 STEP 30000 LAYER met5 ;
TRACKS Y 30000 DO 53 STEP 30000 LAYER met5 ;
TRACKS X 30000 DO 84 STEP 30000 LAYER met6 ;
TRACKS Y 30000 DO 53 STEP 30000 LAYER met6 ;
TRACKS X 30000 DO 84 STEP 30000 LAYER met7 ;
TRACKS Y 30000 DO 53 STEP 30000 LAYER met7 ;
TRACKS X 30000 DO 84 STEP 30000 LAYER met8 ;
TRACKS Y 30000 DO 53 STEP 30000 LAYER met8 ;
TRACKS X 30000 DO 84 STEP 30000 LAYER met9 ;
TRACKS Y 30000 DO 53 STEP 30000 LAYER met9 ;
TRACKS X 30000 DO 84 STEP 30000 LAYER met10 ;
TRACKS Y 30000 DO 53 STEP 30000 LAYER met10 ;
GCELLGRID X 0 DO 5 STEP 450000 ;
GCELLGRID Y 200000 DO 2 STEP 700000 ;
COMPONENTS 6 ;
    - m3 diffmix_25px_0 + PLACED ( 1470000 960000 ) FS ;
    - serp1 serpentine_100px_0 + PLACED ( 1290000 960000 ) FS ;
    - serp2 serpentine_100px_0 + PLACED ( 1110000 960000 ) FS ;
    - serp3 serpentine_100px_0 + PLACED ( 1200000 1200000 ) N ;
    - serp4 serpentine_100px_0 + PLACED ( 930000 960000 ) S ;
    - serp5 serpentine_100px_0 + PLACED ( 1380000 1200000 ) FN ;
END COMPONENTS
PINS 5 ;
    - out + NET out + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met9 ( -7000 -7000 ) ( 7000 7000 )
        + FIXED ( 1590000 1200000 ) N ;
    - soln1 + NET soln1 + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met9 ( -7000 -7000 ) ( 7000 7000 )
        + FIXED ( 1140000 930000 ) N ;
    - soln2 + NET soln2 + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met9 ( -7000 -7000 ) ( 7000 7000 )
        + FIXED ( 1140000 1110000 ) N ;
    - soln3 + NET soln3 + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -7000 -7000 ) ( 7000 7000 )
        + PLACED ( 1230000 1593000 ) N ;
    - soln4 + NET soln4 + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -7000 -7000 ) ( 7000 7000 )
        + PLACED ( 1080000 1593000 ) N ;
END PINS
NETS 8 ;
    - ch1 ( serp2 out_fluid ) ( serp1 out_fluid ) ( m3 a_fluid ) + USE SIGNAL
      + ROUTED met2 ( 1440000 1110000 ) ( * 1140000 )
      NEW met1 ( 1260000 1140000 ) ( 1440000 * )
      NEW met2 ( 1260000 1110000 ) ( * 1140000 )
      NEW met1 ( 1485000 990000 ) ( 1500000 * 0 )
      NEW met3 ( 1440000 990000 ) ( 1485000 * )
      NEW met2 ( 1440000 990000 ) ( * 1110000 )
      NEW met1 ( 1440000 1110000 ) M1M2_PR
      NEW met1 ( 1440000 1140000 ) M1M2_PR
      NEW met1 ( 1260000 1140000 ) M1M2_PR
      NEW met1 ( 1260000 1110000 ) M1M2_PR
      NEW met1 ( 1485000 990000 ) M1M2_PR
      NEW met2 ( 1485000 990000 ) M2M3_PR
      NEW met2 ( 1440000 990000 ) M2M3_PR ;
    - ch2 ( serp4 out_fluid ) ( serp3 out_fluid ) ( m3 b_fluid ) + USE SIGNAL
      + ROUTED met2 ( 1350000 1170000 ) ( * 1230000 )
      NEW met1 ( 1350000 1170000 ) ( 1485000 * )
      NEW met2 ( 1485000 1020000 ) ( * 1170000 )
      NEW met1 ( 1485000 1020000 ) ( 1500000 * 0 )
      NEW met2 ( 960000 1110000 ) ( * 1170000 )
      NEW met1 ( 960000 1170000 ) ( 1350000 * )
      NEW met1 ( 1350000 1230000 ) M1M2_PR
      NEW met1 ( 1350000 1170000 ) M1M2_PR
      NEW met1 ( 1485000 1170000 ) M1M2_PR
      NEW met1 ( 1485000 1020000 ) M1M2_PR
      NEW met1 ( 960000 1110000 ) M1M2_PR
      NEW met1 ( 960000 1170000 ) M1M2_PR ;
    - chm11 ( serp5 in_fluid ) ( m3 out_fluid ) + USE SIGNAL
      + ROUTED met1 ( 1530000 990000 0 ) ( 1545000 * )
      NEW met2 ( 1545000 990000 ) ( * 1050000 )
      NEW met1 ( 1530000 1050000 ) ( 1545000 * )
      NEW met2 ( 1530000 1050000 ) ( * 1230000 )
      NEW met1 ( 1545000 990000 ) M1M2_PR
      NEW met1 ( 1545000 1050000 ) M1M2_PR
      NEW met1 ( 1530000 1050000 ) M1M2_PR
      NEW met1 ( 1530000 1230000 ) M1M2_PR ;
    - out ( PIN out ) ( serp5 out_fluid ) + USE SIGNAL
      + ROUTED met2 ( 1410000 1200000 ) ( * 1230000 )
      NEW met9 ( 1410000 1200000 ) ( 1590000 * 0 )
      NEW met1 ( 1410000 1230000 ) M1M2_PR
      NEW met2 ( 1410000 1200000 ) M2M3_PR
      NEW met3 ( 1410000 1200000 ) M3M4_PR
      NEW met4 ( 1410000 1200000 ) M4M5_PR
      NEW met5 ( 1410000 1200000 ) M5M6_PR
      NEW met6 ( 1410000 1200000 ) M6M7_PR
      NEW met7 ( 1410000 1200000 ) M7M8_PR
      NEW met8 ( 1410000 1200000 ) M8M9_PR ;
    - soln1 ( PIN soln1 ) ( serp1 in_fluid ) + USE SIGNAL
      + ROUTED met2 ( 1320000 930000 ) ( * 1110000 )
      NEW met9 ( 1140000 930000 0 ) ( 1320000 * )
      NEW met1 ( 1320000 1110000 ) M1M2_PR
      NEW met2 ( 1320000 930000 ) M2M3_PR
      NEW met3 ( 1320000 930000 ) M3M4_PR
      NEW met4 ( 1320000 930000 ) M4M5_PR
      NEW met5 ( 1320000 930000 ) M5M6_PR
      NEW met6 ( 1320000 930000 ) M6M7_PR
      NEW met7 ( 1320000 930000 ) M7M8_PR
      NEW met8 ( 1320000 930000 ) M8M9_PR ;
    - soln2 ( PIN soln2 ) ( serp2 in_fluid ) + USE SIGNAL
      + ROUTED met3 ( 1140000 1110000 ) ( 1170000 * )
      NEW met9 ( 1140000 1110000 0 ) ( 1170000 * )
      NEW met1 ( 1140000 1110000 ) M1M2_PR
      NEW met2 ( 1140000 1110000 ) M2M3_PR
      NEW met3 ( 1170000 1110000 ) M3M4_PR
      NEW met4 ( 1170000 1110000 ) M4M5_PR
      NEW met5 ( 1170000 1110000 ) M5M6_PR
      NEW met6 ( 1170000 1110000 ) M6M7_PR
      NEW met7 ( 1170000 1110000 ) M7M8_PR
      NEW met8 ( 1170000 1110000 ) M8M9_PR ;
    - soln3 ( PIN soln3 ) ( serp3 in_fluid ) + USE SIGNAL
      + ROUTED met2 ( 1230000 1230000 ) ( * 1593000 0 )
      NEW met1 ( 1230000 1230000 ) M1M2_PR ;
    - soln4 ( PIN soln4 ) ( serp4 in_fluid ) + USE SIGNAL
      + ROUTED met2 ( 1080000 1110000 ) ( * 1593000 0 )
      NEW met1 ( 1080000 1110000 ) M1M2_PR ;
END NETS
END DESIGN
