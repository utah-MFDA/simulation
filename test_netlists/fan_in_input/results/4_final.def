      NEW met2 ( 930000 930000 ) M2M3_PR
      NEW met3 ( 930000 930000 ) M3M4_PR
      NEW met4 ( 930000 930000 ) M4M5_PR
      NEW met5 ( 930000 930000 ) M5M6_PR
      NEW met6 ( 930000 930000 ) M6M7_PR
      NEW met7 ( 930000 930000 ) M7M8_PR ;
    - soln2 ( PIN soln2 ) ( serp4 in_fluid ) ( serp3 in_fluid ) + USE SIGNAL
      + ROUTED met9 ( 960000 1110000 0 ) ( 1260000 * )
      NEW met3 ( 960000 1110000 ) ( 990000 * )
      NEW met1 ( 1260000 1110000 ) M1M2_PR
      NEW met2 ( 1260000 1110000 ) M2M3_PR
      NEW met3 ( 1260000 1110000 ) M3M4_PR
      NEW met4 ( 1260000 1110000 ) M4M5_PR
      NEW met5 ( 1260000 1110000 ) M5M6_PR
      NEW met6 ( 1260000 1110000 ) M6M7_PR
      NEW met7 ( 1260000 1110000 ) M7M8_PR
      NEW met8 ( 1260000 1110000 ) M8M9_PR
      NEW met1 ( 960000 1110000 ) M1M2_PR
      NEW met2 ( 960000 1110000 ) M2M3_PR
      NEW met3 ( 990000 1110000 ) M3M4_PR
      NEW met4 ( 990000 1110000 ) M4M5_PR
      NEW met5 ( 990000 1110000 ) M5M6_PR
      NEW met6 ( 990000 1110000 ) M6M7_PR
      NEW met7 ( 990000 1110000 ) M7M8_PR
      NEW met8 ( 990000 1110000 ) M8M9_PR ;
END NETS
END DESIGN
