VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN fan_in_input ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 2550000 1600000 ) ;
ROW ROW_0 CoreSite 60000 240000 N DO 81 BY 1 STEP 30000 0 ;
ROW ROW_1 CoreSite 60000 480000 FS DO 81 BY 1 STEP 30000 0 ;
ROW ROW_2 CoreSite 60000 720000 N DO 81 BY 1 STEP 30000 0 ;
ROW ROW_3 CoreSite 60000 960000 FS DO 81 BY 1 STEP 30000 0 ;
ROW ROW_4 CoreSite 60000 1200000 N DO 81 BY 1 STEP 30000 0 ;
TRACKS X 30000 DO 84 STEP 30000 LAYER met1 ;
TRACKS Y 30000 DO 53 STEP 30000 LAYER met1 ;
TRACKS X 30000 DO 84 STEP 30000 LAYER met2 ;
TRACKS Y 30000 DO 53 STEP 30000 LAYER met2 ;
TRACKS X 30000 DO 84 STEP 30000 LAYER met3 ;
TRACKS Y 30000 DO 53 STEP 30000 LAYER met3 ;
TRACKS X 30000 DO 84 STEP 30000 LAYER met4 ;
TRACKS Y 30000 DO 53 STEP 30000 LAYER met4 ;
TRACKS X 30000 DO 84 STEP 30000 LAYER met5 ;
TRACKS Y 30000 DO 53 STEP 30000 LAYER met5 ;
TRACKS X 30000 DO 84 STEP 30000 LAYER met6 ;
TRACKS Y 30000 DO 53 STEP 30000 LAYER met6 ;
TRACKS X 30000 DO 84 STEP 30000 LAYER met7 ;
TRACKS Y 30000 DO 53 STEP 30000 LAYER met7 ;
TRACKS X 30000 DO 84 STEP 30000 LAYER met8 ;
TRACKS Y 30000 DO 53 STEP 30000 LAYER met8 ;
TRACKS X 30000 DO 84 STEP 30000 LAYER met9 ;
TRACKS Y 30000 DO 53 STEP 30000 LAYER met9 ;
TRACKS X 30000 DO 84 STEP 30000 LAYER met10 ;
TRACKS Y 30000 DO 53 STEP 30000 LAYER met10 ;
GCELLGRID X 0 DO 5 STEP 450000 ;
GCELLGRID Y 450000 DO 2 STEP 700000 ;
COMPONENTS 8 ;
    - m1 diffmix_25px_0 + PLACED ( 1290000 960000 ) FS ;
    - m2 diffmix_25px_0 + PLACED ( 1050000 1200000 ) N ;
    - m3 diffmix_25px_0 + PLACED ( 1140000 1200000 ) N ;
    - serp1 serpentine_100px_0 + PLACED ( 750000 960000 ) S ;
    - serp2 serpentine_100px_0 + PLACED ( 930000 720000 ) N ;
    - serp3 serpentine_100px_0 + PLACED ( 930000 960000 ) FS ;
    - serp4 serpentine_100px_0 + PLACED ( 1110000 960000 ) S ;
    - serp5 serpentine_100px_0 + PLACED ( 1260000 1200000 ) N ;
END COMPONENTS
PINS 3 ;
    - out + NET out + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met9 ( -7000 -7000 ) ( 7000 7000 )
        + FIXED ( 1590000 1200000 ) N ;
    - soln1 + NET soln1 + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met9 ( -7000 -7000 ) ( 7000 7000 )
        + FIXED ( 960000 930000 ) N ;
    - soln2 + NET soln2 + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met9 ( -7000 -7000 ) ( 7000 7000 )
        + FIXED ( 960000 1110000 ) N ;
END PINS
NETS 10 ;
    - ch1 ( serp1 out_fluid ) ( m1 a_fluid ) + USE SIGNAL
      + ROUTED met2 ( 780000 960000 ) ( * 1110000 )
      NEW met1 ( 1305000 990000 ) ( 1320000 * 0 )
      NEW met3 ( 1125000 990000 ) ( 1305000 * )
      NEW met1 ( 1110000 990000 ) ( 1125000 * )
      NEW met2 ( 1110000 960000 ) ( * 990000 )
      NEW met3 ( 1050000 960000 ) ( 1110000 * )
      NEW met1 ( 780000 960000 ) ( 1050000 * )
      NEW met1 ( 780000 960000 ) M1M2_PR
      NEW met1 ( 780000 1110000 ) M1M2_PR
      NEW met1 ( 1305000 990000 ) M1M2_PR
      NEW met2 ( 1305000 990000 ) M2M3_PR
      NEW met1 ( 1125000 990000 ) M1M2_PR
      NEW met2 ( 1125000 990000 ) M2M3_PR
      NEW met1 ( 1110000 990000 ) M1M2_PR
      NEW met2 ( 1110000 960000 ) M2M3_PR
      NEW met1 ( 1050000 960000 ) M1M2_PR
      NEW met2 ( 1050000 960000 ) M2M3_PR ;
    - ch2 ( serp2 out_fluid ) ( m1 b_fluid ) + USE SIGNAL
      + ROUTED met1 ( 1305000 1020000 ) ( 1320000 * 0 )
      NEW met3 ( 1260000 1020000 ) ( 1305000 * )
      NEW met2 ( 1260000 900000 ) ( * 1020000 )
      NEW met1 ( 1080000 900000 ) ( 1260000 * )
      NEW met2 ( 1080000 750000 ) ( * 900000 )
      NEW met1 ( 1305000 1020000 ) M1M2_PR
      NEW met2 ( 1305000 1020000 ) M2M3_PR
      NEW met2 ( 1260000 1020000 ) M2M3_PR
      NEW met1 ( 1260000 900000 ) M1M2_PR
      NEW met1 ( 1080000 900000 ) M1M2_PR
      NEW met1 ( 1080000 750000 ) M1M2_PR ;
    - ch3 ( serp3 out_fluid ) ( m2 a_fluid ) + USE SIGNAL
      + ROUTED met1 ( 1065000 1260000 ) ( 1080000 * 0 )
      NEW met3 ( 1050000 1260000 ) ( 1065000 * )
      NEW met2 ( 1050000 1170000 ) ( * 1260000 )
      NEW met1 ( 1050000 1170000 ) ( 1080000 * )
      NEW met2 ( 1080000 1110000 ) ( * 1170000 )
      NEW met1 ( 1065000 1260000 ) M1M2_PR
      NEW met2 ( 1065000 1260000 ) M2M3_PR
      NEW met2 ( 1050000 1260000 ) M2M3_PR
      NEW met1 ( 1050000 1170000 ) M1M2_PR
      NEW met1 ( 1080000 1170000 ) M1M2_PR
      NEW met1 ( 1080000 1110000 ) M1M2_PR ;
    - ch4 ( serp4 out_fluid ) ( m2 b_fluid ) + USE SIGNAL
      + ROUTED met1 ( 1065000 1230000 ) ( 1080000 * 0 )
      NEW met3 ( 1065000 1230000 ) ( 1080000 * )
      NEW met4 ( 1080000 1200000 ) ( * 1230000 )
      NEW met2 ( 1080000 1140000 ) ( * 1200000 )
      NEW met1 ( 1080000 1140000 ) ( 1140000 * )
      NEW met2 ( 1140000 1110000 ) ( * 1140000 )
      NEW met1 ( 1065000 1230000 ) M1M2_PR
      NEW met2 ( 1065000 1230000 ) M2M3_PR
      NEW met3 ( 1080000 1230000 ) M3M4_PR
      NEW met2 ( 1080000 1200000 ) M2M3_PR
      NEW met3 ( 1080000 1200000 ) M3M4_PR
      NEW met1 ( 1080000 1140000 ) M1M2_PR
      NEW met1 ( 1140000 1140000 ) M1M2_PR
      NEW met1 ( 1140000 1110000 ) M1M2_PR ;
    - chm01 ( m3 a_fluid ) ( m1 out_fluid ) + USE SIGNAL
      + ROUTED met1 ( 1350000 990000 0 ) ( 1365000 * )
      NEW met2 ( 1365000 990000 ) ( * 1140000 )
      NEW met1 ( 1170000 1140000 ) ( 1365000 * )
      NEW met4 ( 1170000 1140000 ) ( * 1260000 )
      NEW met3 ( 1155000 1260000 ) ( 1170000 * )
      NEW met1 ( 1155000 1260000 ) ( 1170000 * 0 )
      NEW met1 ( 1365000 990000 ) M1M2_PR
      NEW met1 ( 1365000 1140000 ) M1M2_PR
      NEW met1 ( 1170000 1140000 ) M1M2_PR
      NEW met2 ( 1170000 1140000 ) M2M3_PR
      NEW met3 ( 1170000 1140000 ) M3M4_PR
      NEW met3 ( 1170000 1260000 ) M3M4_PR
      NEW met1 ( 1155000 1260000 ) M1M2_PR
      NEW met2 ( 1155000 1260000 ) M2M3_PR ;
    - chm02 ( m3 b_fluid ) ( m2 out_fluid ) + USE SIGNAL
      + ROUTED met1 ( 1110000 1260000 0 ) ( 1125000 * )
      NEW met2 ( 1125000 1230000 ) ( * 1260000 )
      NEW met1 ( 1125000 1230000 ) ( 1140000 * )
      NEW met3 ( 1140000 1230000 ) ( 1155000 * )
      NEW met1 ( 1155000 1230000 ) ( 1170000 * 0 )
      NEW met1 ( 1125000 1260000 ) M1M2_PR
      NEW met1 ( 1125000 1230000 ) M1M2_PR
      NEW met1 ( 1140000 1230000 ) M1M2_PR
      NEW met2 ( 1140000 1230000 ) M2M3_PR
      NEW met1 ( 1155000 1230000 ) M1M2_PR
      NEW met2 ( 1155000 1230000 ) M2M3_PR ;
    - chm11 ( serp5 in_fluid ) ( m3 out_fluid ) + USE SIGNAL
      + ROUTED met1 ( 1200000 1260000 0 ) ( 1215000 * )
      NEW met2 ( 1215000 1230000 ) ( * 1260000 )
      NEW met1 ( 1215000 1230000 ) ( 1260000 * )
      NEW met3 ( 1260000 1230000 ) ( 1290000 * )
      NEW met1 ( 1215000 1260000 ) M1M2_PR
      NEW met1 ( 1215000 1230000 ) M1M2_PR
      NEW met1 ( 1260000 1230000 ) M1M2_PR
      NEW met2 ( 1260000 1230000 ) M2M3_PR
      NEW met1 ( 1290000 1230000 ) M1M2_PR
      NEW met2 ( 1290000 1230000 ) M2M3_PR ;
    - out ( PIN out ) ( serp5 out_fluid ) + USE SIGNAL
      + ROUTED met2 ( 1410000 1200000 ) ( * 1230000 )
      NEW met9 ( 1410000 1200000 ) ( 1590000 * 0 )
      NEW met1 ( 1410000 1230000 ) M1M2_PR
      NEW met2 ( 1410000 1200000 ) M2M3_PR
      NEW met3 ( 1410000 1200000 ) M3M4_PR
      NEW met4 ( 1410000 1200000 ) M4M5_PR
      NEW met5 ( 1410000 1200000 ) M5M6_PR
      NEW met6 ( 1410000 1200000 ) M6M7_PR
      NEW met7 ( 1410000 1200000 ) M7M8_PR
      NEW met8 ( 1410000 1200000 ) M8M9_PR ;
    - soln1 ( PIN soln1 ) ( serp2 in_fluid ) ( serp1 in_fluid ) + USE SIGNAL
      + ROUTED met9 ( 930000 930000 ) ( 960000 * 0 )
      NEW met8 ( 930000 930000 ) ( * 1110000 )
      NEW met7 ( 900000 1110000 ) ( 930000 * )
      NEW met2 ( 960000 750000 ) ( * 930000 )
      NEW met1 ( 930000 930000 ) ( 960000 * )
      NEW met8 ( 930000 930000 ) M8M9_PR
      NEW met7 ( 930000 1110000 ) M7M8_PR
      NEW met1 ( 900000 1110000 ) M1M2_PR
      NEW met2 ( 900000 1110000 ) M2M3_PR
      NEW met3 ( 900000 1110000 ) M3M4_PR
      NEW met4 ( 900000 1110000 ) M4M5_PR
